# Environment values for local development only.
# Use `npx supabase status -o env` for the URL and local service-role key.
# Do not prefix either value with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Read locally from your ignored credential file. Never commit the key.
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
